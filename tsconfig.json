{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@clarity/domain-contracts": ["./packages/domain-contracts/src/index.ts"],
      "@clarity/case-repository": ["./packages/case-repository/src/index.ts"],
      "@clarity/case-service": ["./packages/case-service/src/index.ts"],
      "@clarity/document-service": ["./packages/document-service/src/index.ts"],
      "@clarity/legal-hold-forms": ["./packages/legal-hold-forms/src/index.ts"],
      "@clarity/api-service": ["./packages/api-service/src/index.ts"],
      "@clarity/evidence-service": ["./packages/evidence-service/src/index.ts"],
      "@clarity/benefits-service": ["./packages/benefits-service/src/index.ts"],
      "@clarity/authorization-service": ["./packages/authorization-service/src/index.ts"],
      "@clarity/auth-service": ["./packages/auth-service/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "app"]
}
