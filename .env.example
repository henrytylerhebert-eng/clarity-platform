# Copy to .env and adjust. Local development only — never commit real credentials.
DATABASE_URL="postgresql://clarity:clarity@localhost:5432/clarity_dev?schema=public"

# OD-6 provider-backed target (see docs/architecture/ADR-0022-supabase-provider-swap.md).
# Deliberately separate from DATABASE_URL — assertLocalClarityDevDatabase blocks any
# non-localhost host, so this is never used by the test suite or the dev server. Set
# only when running a migration or manual check directly against the provider.
# SUPABASE_DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
