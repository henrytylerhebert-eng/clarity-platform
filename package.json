{
  "name": "clarity-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Clarity behavioral-health case intelligence and workflow platform (synthetic data only; not a deployed clinical system)",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:app": "npm --workspace app test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "migration:recovery:local": "tsx scripts/verify-local-migration-recovery.ts",
    "api:dev": "tsx packages/api-service/src/devMain.ts",
    "bridge:doctor": "agents/bridge/agent-bridge doctor",
    "bridge:status": "agents/bridge/agent-bridge status",
    "bridge:test": "python3 -m unittest discover -s agents/bridge/tests",
    "regulatory:check": "tsx scripts/regulatory-corpus/cli.ts check",
    "regulatory:sync": "tsx scripts/regulatory-corpus/cli.ts sync",
    "regulatory:index": "tsx scripts/regulatory-corpus/cli.ts index",
    "regulatory:fr": "tsx scripts/regulatory-corpus/cli.ts federal-register"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.7.0",
    "jsdom": "^25.0.1",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.6",
    "zod": "^3.24.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.21.5": true,
    "@prisma/client@7.8.0": true
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
