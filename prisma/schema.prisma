model Organization {
  id                String                 @id @default(cuid())
  name              String
  type              OrganizationType
  status            OrganizationStatus     @default(ACTIVE)
  jurisdictionCodes String[]
  users             User[]
  cases             BehavioralHealthCase[]
  facilities        FacilityProfile[]
  payerProfiles     PayerProfile[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model User {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  email          String                 @unique
  displayName    String
  roles          UserRole[]
  status         UserStatus             @default(ACTIVE)
  lastLoginAt    DateTime?
  assignedCases  BehavioralHealthCase[] @relation("AssignedCases")
  reviews        HumanReview[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  authSessions   AuthSession[]

  @@index([organizationId])
}

/// Server-side session record (ADR-0011). The raw bearer token is returned
/// to the caller exactly once and stored ONLY as a SHA-256 hash — no code
/// path can recover it. Revocation is a timestamp, never a delete, so the
/// session trail survives for audit.
model AuthSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  organizationId String
  tokenHash      String    @unique
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model PatientToken {
  id                       String                 @id @default(cuid())
  organizationId           String
  externalPatientReference String?
  dateOfBirth              DateTime?
  age                      Int?
  sex                      String?
  preferredLanguage        String?
  guardianStatus           String?
  privacyFlags             String[]
  cases                    BehavioralHealthCase[]
  coverages                InsuranceCoverage[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([organizationId])
}

model BehavioralHealthCase {
  id                        String                     @id @default(cuid())
  organizationId            String
  organization              Organization               @relation(fields: [organizationId], references: [id])
  patientTokenId            String
  patientToken              PatientToken               @relation(fields: [patientTokenId], references: [id])
  assignedUserId            String?
  assignedUser              User?                      @relation("AssignedCases", fields: [assignedUserId], references: [id])
  status                    CaseStatus                 @default(DRAFT)
  urgency                   UrgencyLevel               @default(ROUTINE)
  currentLocation           String?
  requestedLevelOfCare      LevelOfCare?
  currentLegalStatus        LegalStatusType?
  clinicalStatus            ParallelWorkstreamStatus   @default(NOT_STARTED)
  legalReviewStatus         ParallelWorkstreamStatus   @default(NOT_STARTED)
  medicalScreeningStatus    ParallelWorkstreamStatus   @default(NOT_STARTED)
  benefitsStatus            ParallelWorkstreamStatus   @default(NOT_STARTED)
  authorizationStatus       ParallelWorkstreamStatus   @default(NOT_STARTED)
  placementStatus           ParallelWorkstreamStatus   @default(NOT_STARTED)
  transportationStatus      ParallelWorkstreamStatus   @default(NOT_STARTED)
  patientEducationStatus    ParallelWorkstreamStatus   @default(NOT_STARTED)
  openedAt                  DateTime                   @default(now())
  closedAt                  DateTime?
  /// Optimistic-concurrency token: incremented by every mutation; commands
  /// carry an expectedVersion and fail safely when it is stale.
  version                   Int                        @default(0)
  documents                 SourceDocument[]
  evidenceItems             EvidenceItem[]
  reviews                   HumanReview[]
  legalStatuses             LegalStatusRecord[]
  medicalNecessityReviews   MedicalNecessityReview[]
  coverages                 InsuranceCoverage[]
  authorizations            Authorization[]
  financialEducationRecords FinancialEducationRecord[]
  referrals                 Referral[]
  custodyEvents             CustodyEvent[]
  auditEvents               AuditEvent[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  contradictionGroups       ContradictionGroup[]
  episodes                  Episode[]
  episodeLinks              CaseEpisodeLink[]
  prescreenEncounters       PrescreenEncounter[]

  @@index([organizationId, status])
  @@index([assignedUserId])
  @@index([patientTokenId])
}

model SourceDocument {
  id                   String                       @id @default(cuid())
  caseId               String
  case                 BehavioralHealthCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organizationId       String
  documentType         DocumentType
  filename             String
  mimeType             String
  storageKey           String
  sha256               String
  /// Actual byte length of the stored content, measured from the bytes
  /// themselves at upload time (never caller-reported).
  fileSizeBytes        Int
  /// Version-family root: equals the first version's id. All versions of the
  /// same logical document share it; the current version is the family's
  /// highest `version`. (ADR-0007)
  documentFamilyId     String
  sourceOrganization   String?
  authorName           String?
  serviceDate          DateTime?
  uploadedBy           String
  uploadedAt           DateTime                     @default(now())
  classificationStatus DocumentClassificationStatus @default(PENDING)
  version              Int                          @default(1)
  evidenceItems        EvidenceItem[]
  benefitSources       BenefitVerificationSource[]
  eligibilityProofs    EligibilityProof[]
  createdAt            DateTime                     @default(now())

  @@unique([caseId, sha256, version])
  @@index([organizationId, caseId])
  @@index([documentFamilyId])
}

model EvidenceItem {
  id                   String               @id @default(cuid())
  caseId               String
  case                 BehavioralHealthCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organizationId       String
  documentId           String
  document             SourceDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  category             EvidenceCategory
  subcategory          String?
  /// Verbatim source text, captured at creation and never updated by any
  /// code path — corrections touch normalizedValue/annotations only;
  /// material changes create a superseding item (ADR-0008).
  originalText         String
  normalizedValue      Json?
  pageNumber           Int?
  sectionLabel         String?
  sourceAuthor         String?
  sourceTimestamp      DateTime?
  /// Null for human-entered evidence; reserved for future automation.
  extractionConfidence Float?
  status               EvidenceStatus       @default(CANDIDATE)
  /// How the item came to exist. Contract vocabulary: HUMAN_ENTRY (only
  /// value until automated extraction exists).
  creationMethod       String
  createdBy            String
  reviewerNote         String?
  reviewedBy           String?
  reviewedAt           DateTime?
  /// Correction chain root: the first item's id, shared by every item that
  /// supersedes it.
  evidenceFamilyId     String
  supersededById       String?
  supersededBy         EvidenceItem?        @relation("EvidenceSupersession", fields: [supersededById], references: [id])
  supersedes           EvidenceItem[]       @relation("EvidenceSupersession")
  contradictionGroupId String?
  contradictionGroup   ContradictionGroup?  @relation(fields: [contradictionGroupId], references: [id])
  /// Optimistic-concurrency token, same discipline as cases/documents.
  version              Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([caseId, category, status])
  @@index([documentId])
  @@index([organizationId, caseId])
  @@index([evidenceFamilyId])
  @@index([contradictionGroupId])
  @@index([supersededById])
}

/// A reviewer-visible grouping of conflicting evidence. Grouping never
/// changes any member's status; classification records what KIND of
/// discrepancy a human judged it to be, not which side is correct.
model ContradictionGroup {
  id             String               @id @default(cuid())
  organizationId String
  caseId         String
  case           BehavioralHealthCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Contract vocabulary: DIRECT_CONFLICT | TEMPORAL_CHANGE |
  /// SOURCE_DISAGREEMENT | UNCLEAR. Null until a reviewer classifies.
  classification String?
  reviewNote     String?
  createdBy      String
  version        Int                  @default(0)
  items          EvidenceItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, caseId])
}

model HumanReview {
  id         String               @id @default(cuid())
  caseId     String
  case       BehavioralHealthCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  objectType ReviewObjectType
  objectId   String
  reviewerId String
  reviewer   User                 @relation(fields: [reviewerId], references: [id])
  decision   ReviewDecision
  rationale  String?
  reviewedAt DateTime             @default(now())

  @@index([caseId, objectType])
  @@index([reviewerId])
}

model LegalStatusRecord {
  id                       String                   @id @default(cuid())
  caseId                   String
  case                     BehavioralHealthCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  jurisdiction             String
  statusType               LegalStatusType
  authorizingAuthority     String?
  /// License board of the signing professional (LSBME/LSBN/LSBEP), when known —
  /// together with authorizingLicenseNumber, the stable key for tracking how
  /// often a professional issues these instruments (a license persists across
  /// facilities/organizations; there is no cross-organization "professional"
  /// entity in this schema, so this pair is the closest stable identifier).
  authorizingLicenseBoard  String?
  authorizingLicenseNumber String?
  initiatedAt              DateTime?
  expiresAt                DateTime?
  formDocumentId           String?
  signatureStatus          String?
  reviewStatus             ParallelWorkstreamStatus @default(NOT_STARTED)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([caseId, jurisdiction])
  @@index([authorizingLicenseBoard, authorizingLicenseNumber])
}

model MedicalNecessityReview {
  id                 String               @id @default(cuid())
  caseId             String
  case               BehavioralHealthCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedLevel     LevelOfCare
  criteriaSetId      String
  criteriaVersion    String
  supportingEvidence Json
  missingEvidence    Json
  contradictions     Json
  draftNarrative     String?
  reviewerId         String?
  decision           ReviewDecision?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([caseId])
}

model RuleSet {
  id                String        @id @default(cuid())
  name              String
  domain            RuleDomain
  jurisdiction      String?
  issuingAuthority  String?
  version           String
  effectiveDate     DateTime
  reviewDate        DateTime?
  status            RuleSetStatus @default(DRAFT)
  sourceDocumentIds String[]
  approvedBy        String?
  approvedAt        DateTime?
  rules             Rule[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([name, version])
}

model Rule {
  id                  String      @id @default(cuid())
  ruleSetId           String
  ruleSet             RuleSet     @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  code                String
  title               String
  description         String
  conditionExpression Json
  outcome             RuleOutcome
  messageTemplate     String
  citationReference   String?
  severity            Severity
  createdAt           DateTime    @default(now())

  @@unique([ruleSetId, code])
}

model PayerProfile {
  id                         String              @id @default(cuid())
  organizationId             String
  organization               Organization        @relation(fields: [organizationId], references: [id])
  legalName                  String
  aliases                    String[]
  portalUrlLabel             String?
  eligibilityPhone           String?
  authorizationPhone         String?
  faxNumber                  String?
  behavioralHealthCarveOut   String?
  typicalVerificationMinutes Int?
  typicalAuthorizationHours  Int?
  commonPendReasons          String[]
  commonDenialReasons        String[]
  lastVerifiedAt             DateTime?
  planProfiles               PlanProfile[]
  coverages                  InsuranceCoverage[]
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  @@index([organizationId, legalName])
}

model PlanProfile {
  id                       String              @id @default(cuid())
  payerProfileId           String
  payerProfile             PayerProfile        @relation(fields: [payerProfileId], references: [id], onDelete: Cascade)
  name                     String
  planType                 CoverageType
  knownNetworkRelationship NetworkStatus       @default(UNKNOWN)
  commonBenefitStructure   Json?
  authorizationPattern     Json?
  commonExclusions         String[]
  historicalReimbursement  Json?
  confidenceLevel          Float?
  lastValidatedAt          DateTime?
  coverages                InsuranceCoverage[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([payerProfileId, name])
}

model InsuranceSubscriber {
  id                    String                 @id @default(cuid())
  caseId                String
  fullName              String?
  dateOfBirth           DateTime?
  relationshipToPatient SubscriberRelationship
  employerName          String?
  sourceDocumentIds     String[]
  coverages             InsuranceCoverage[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([caseId])
}

model InsuranceCoverage {
  id                     String                    @id @default(cuid())
  caseId                 String
  case                   BehavioralHealthCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organizationId         String
  patientTokenId         String
  patientToken           PatientToken              @relation(fields: [patientTokenId], references: [id])
  coverageOrder          CoverageOrder
  payerProfileId         String?
  payerProfile           PayerProfile?             @relation(fields: [payerProfileId], references: [id])
  planProfileId          String?
  planProfile            PlanProfile?              @relation(fields: [planProfileId], references: [id])
  payerNameRaw           String?
  planNameRaw            String?
  memberIdEncrypted      String?
  groupNumberEncrypted   String?
  policyNumberEncrypted  String?
  coverageType           CoverageType
  subscriberRelationship SubscriberRelationship
  subscriberId           String?
  subscriber             InsuranceSubscriber?      @relation(fields: [subscriberId], references: [id])
  status                 CoverageStatus            @default(UNVERIFIED)
  sourceDocumentIds      String[]
  reviewedBy             String?
  reviewedAt             DateTime?
  eligibilityChecks      EligibilityVerification[]
  benefitVerifications   BenefitVerification[]
  authorizations         Authorization[]
  /// Optimistic-concurrency token for the status rollup, same discipline as
  /// cases/documents/evidence.
  version                Int                       @default(0)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([caseId, coverageOrder])
  @@index([payerProfileId])
  @@index([organizationId, caseId])
}

model EligibilityVerification {
  id                  String             @id @default(cuid())
  insuranceCoverageId String
  insuranceCoverage   InsuranceCoverage  @relation(fields: [insuranceCoverageId], references: [id], onDelete: Cascade)
  method              VerificationMethod
  status              EligibilityStatus
  effectiveDate       DateTime?
  terminationDate     DateTime?
  verifiedAt          DateTime?
  verifiedBy          String?
  payerRepresentative String?
  referenceNumber     String?
  notes               String?
  proofs              EligibilityProof[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([insuranceCoverageId, verifiedAt])
}

model EligibilityProof {
  id                        String                  @id @default(cuid())
  eligibilityVerificationId String
  eligibilityVerification   EligibilityVerification @relation(fields: [eligibilityVerificationId], references: [id], onDelete: Cascade)
  documentId                String
  document                  SourceDocument          @relation(fields: [documentId], references: [id])
  createdAt                 DateTime                @default(now())

  @@unique([eligibilityVerificationId, documentId])
}

model BenefitVerification {
  id                    String                      @id @default(cuid())
  insuranceCoverageId   String
  insuranceCoverage     InsuranceCoverage           @relation(fields: [insuranceCoverageId], references: [id], onDelete: Cascade)
  serviceType           ServiceType
  networkStatus         NetworkStatus               @default(UNKNOWN)
  deductibleAmountCents Int?
  deductibleMetCents    Int?
  coinsurancePercent    Float?
  copayAmountCents      Int?
  outOfPocketMaxCents   Int?
  outOfPocketMetCents   Int?
  authorizationRequired Boolean?
  notificationRequired  Boolean?
  coverageLimit         String?
  exclusions            String[]
  quotedAt              DateTime?
  verificationReference String?
  disclaimerStatus      DisclaimerStatus            @default(REQUIRED)
  sources               BenefitVerificationSource[]
  educationRecords      FinancialEducationRecord[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([insuranceCoverageId, serviceType])
}

model BenefitVerificationSource {
  id                    String              @id @default(cuid())
  benefitVerificationId String
  benefitVerification   BenefitVerification @relation(fields: [benefitVerificationId], references: [id], onDelete: Cascade)
  documentId            String
  document              SourceDocument      @relation(fields: [documentId], references: [id])
  createdAt             DateTime            @default(now())

  @@unique([benefitVerificationId, documentId])
}

model Authorization {
  id                   String               @id @default(cuid())
  caseId               String
  case                 BehavioralHealthCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organizationId       String
  insuranceCoverageId  String
  insuranceCoverage    InsuranceCoverage    @relation(fields: [insuranceCoverageId], references: [id])
  requestedLevelOfCare LevelOfCare
  status               AuthorizationStatus  @default(NOT_STARTED)
  authorizationNumber  String?
  requestedAt          DateTime?
  decisionAt           DateTime?
  approvedStartDate    DateTime?
  approvedEndDate      DateTime?
  approvedUnits        Int?
  nextReviewDate       DateTime?
  denialReason         String?
  appealStatus         String?
  assignedUserId       String?
  /// Optimistic-concurrency token, same discipline as every other aggregate.
  version              Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([caseId, status])
  @@index([insuranceCoverageId])
  @@index([organizationId, caseId])
}

model FinancialEducationRecord {
  id                     String                 @id @default(cuid())
  caseId                 String
  case                   BehavioralHealthCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  benefitVerificationId  String?
  benefitVerification    BenefitVerification?   @relation(fields: [benefitVerificationId], references: [id])
  recipientType          EducationRecipientType
  recipientName          String?
  method                 EducationMethod
  language               String?
  interpreterUsed        Boolean                @default(false)
  topicsReviewed         String[]
  uncertaintiesDisclosed String[]
  acknowledgementStatus  AcknowledgementStatus
  educatedBy             String
  educatedAt             DateTime               @default(now())

  @@index([caseId, educatedAt])
}

model FacilityProfile {
  id                      String                          @id @default(cuid())
  organizationId          String
  organization            Organization                    @relation(fields: [organizationId], references: [id])
  name                    String
  programs                LevelOfCare[]
  acceptedAges            Json?
  acceptedCoverageTypes   CoverageType[]
  medicalCapabilities     String[]
  exclusionCriteria       String[]
  legalStatusCapabilities LegalStatusType[]
  transportationRules     String[]
  referralRequirements    String[]
  lastVerifiedAt          DateTime?
  referrals               Referral[]
  episodes                Episode[]
  timezoneConfigurations  FacilityTimezoneConfiguration[]
  revOpsWorkspaces        RevOpsWorkspace[]
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  @@index([organizationId, name])
  @@unique([organizationId, id])
}

/// Bounded aggregate patient-day workspace. No patient records or forecast/cash values.
model RevOpsWorkspace {
  id             String @id @default(cuid())
  organizationId String
  facilityId     String
  unit           String
  facility       FacilityProfile @relation(fields: [organizationId, facilityId], references: [organizationId, id])
  revision       Int @default(1)
  state          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  changes        RevOpsChange[]

  @@unique([organizationId, facilityId, unit])
  @@unique([organizationId, id])
}

/// Immutable application audit records; no update/delete command is exposed.
model RevOpsChange {
  id             String @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      RevOpsWorkspace @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  revision       Int
  actorId        String
  action         String
  details        Json
  occurredAt     DateTime @default(now())

  @@unique([organizationId, workspaceId, revision])
}

model Referral {
  id                   String               @id @default(cuid())
  caseId               String
  case                 BehavioralHealthCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  facilityId           String
  facility             FacilityProfile      @relation(fields: [facilityId], references: [id])
  packetVersion        Int
  sentAt               DateTime?
  status               ReferralStatus       @default(DRAFT)
  responseAt           DateTime?
  responseReason       String?
  requestedInformation String[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([caseId, status])
  @@index([facilityId])
}

model CustodyEvent {
  id                String               @id @default(cuid())
  caseId            String
  case              BehavioralHealthCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromPartyType     CustodyPartyType
  fromPartyName     String?
  toPartyType       CustodyPartyType
  toPartyName       String?
  authority         String?
  location          String?
  occurredAt        DateTime
  transportProvider String?
  documentationIds  String[]
  createdAt         DateTime             @default(now())

  @@index([caseId, occurredAt])
}

model AuditEvent {
  id                String                @id @default(cuid())
  organizationId    String
  caseId            String?
  case              BehavioralHealthCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorType         AuditActorType
  actorId           String
  action            String
  objectType        String
  objectId          String?
  previousStateHash String?
  newStateHash      String?
  reason            String?
  modelMetadata     Json?
  timestamp         DateTime              @default(now())
  ipAddressHash     String?

  @@index([organizationId, timestamp])
  @@index([caseId, timestamp])
}

/// Idempotency guard for retried case commands. One row per
/// (organization, idempotencyKey); replays return the recorded outcome
/// instead of re-executing the command. Rows are append-only.
model CommandIdempotencyRecord {
  id                 String   @id @default(cuid())
  organizationId     String
  idempotencyKey     String
  commandType        String
  caseId             String?
  /// Non-case object a replay must rehydrate (e.g. an evidence item id).
  objectId           String?
  /// Canonical recursively-sorted SHA-256 of the command body (nullable:
  /// only fingerprint-checked commands — prescreen, ADR-0014 §5 — set it).
  /// Same key + same fingerprint replays; same key + different fingerprint
  /// is an idempotency conflict.
  requestFingerprint String?
  resultVersion      Int?
  createdAt          DateTime @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// S2 persistence: episodes, episode-owned utilization review, governed events,
// and the transactional outbox. Additive, synthetic-only, runtime-free
// (docs/decisions/S2_PERSISTENCE_DECISION_PACKET.md). Domain shapes live in
// @clarity/domain-contracts (episode.ts, utilizationReview.ts, analytics.ts);
// these tables persist those contracts. No HTTP, workers, dispatch, marts, UI,
// or RLS are introduced here.
// ---------------------------------------------------------------------------

enum EpisodeStatus {
  ACTIVE
  DISCHARGED
  CLOSED
}

enum CaseEpisodeRelationship {
  ADMISSION_SOURCE
  TRANSFER_SOURCE
  READMISSION_SOURCE
}

enum EpisodeAuthorizationRequirement {
  REQUIRED
  NOT_REQUIRED
  UNKNOWN
}

enum EpisodeAuthorizationStatus {
  OPEN
  CLOSED
  SUPERSEDED
}

enum AuthorizationReviewType {
  INITIAL
  CONCURRENT
  RETROSPECTIVE
  PEER_TO_PEER
  APPEAL
}

enum AuthorizationReviewStatus {
  PENDING
  APPROVED
  DENIED
  WITHDRAWN
  UNKNOWN
}

enum AuthorizationDayOutcome {
  APPROVED
  DENIED
  PENDING
}

enum DenialReasonCode {
  MISSING_AUTHORIZATION
  LATE_REVIEW
  DOCUMENTATION_GAP
  LEVEL_OF_CARE_NOT_SUPPORTED
  ELIGIBILITY_OR_COVERAGE
  OTHER_CONTROLLED
}

enum DocumentationGapCategory {
  MISSING_PROGRESS_NOTE
  MISSING_PHYSICIAN_ORDER
  MISSING_TREATMENT_PLAN
  MISSING_RISK_UPDATE
  MISSING_DISCHARGE_PLAN
  MISSING_SIGNATURE_OR_ATTESTATION
  INCONSISTENT_LEVEL_OF_CARE_SUPPORT
  PAYER_REQUESTED_CLARIFICATION
  OTHER_CONTROLLED
}

enum DocumentationGapStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISPUTED
  REOPENED
  CANCELLED
  SUPERSEDED
}

/// Facility-owned timezone lineage (S2 decision 3). The service date behind
/// every episode day is derived ONLY from an explicit facility-configuration
/// source reference, its version, and its effective date — never inferred from
/// browser, server, or organization name. Rows are append-only: a new version
/// supersedes the prior one via `supersededById`; the old row is never edited.
model FacilityTimezoneConfiguration {
  id                String                         @id @default(cuid())
  organizationId    String
  facilityProfileId String
  facilityProfile   FacilityProfile                @relation(fields: [facilityProfileId], references: [id])
  /// IANA timezone name (validated against Intl before persistence).
  facilityTimezone  String
  /// Controlled source vocabulary; today only FACILITY_CONFIGURATION.
  source            String
  /// The facility-owned configuration record this value came from.
  sourceReferenceId String
  /// Monotonic version of this facility's timezone configuration.
  version           Int
  /// Date from which this configuration version is effective.
  effectiveDate     DateTime
  /// Set when a newer version replaces this one; the old row is frozen.
  supersededById    String?                        @unique
  supersededBy      FacilityTimezoneConfiguration? @relation("FacilityTimezoneSupersession", fields: [supersededById], references: [id])
  supersedes        FacilityTimezoneConfiguration? @relation("FacilityTimezoneSupersession")
  episodes          Episode[]
  createdAt         DateTime                       @default(now())

  @@unique([facilityProfileId, version])
  @@index([organizationId, facilityProfileId])
}

/// An episode of care created when an accepted case is admitted to a facility
/// (S2 decision 1: at most one active ADMISSION_SOURCE episode per case,
/// enforced by the CaseEpisodeLink acceptance unique + gateway predicate).
/// Reuses Organization/FacilityProfile; program/unit remain nullable,
/// source-owned identifiers until a canonical hierarchy exists (decision 2).
model Episode {
  id                         String                         @id @default(cuid())
  organizationId             String
  sourceCaseId               String
  sourceCase                 BehavioralHealthCase           @relation(fields: [sourceCaseId], references: [id])
  facilityId                 String
  facility                   FacilityProfile                @relation(fields: [facilityId], references: [id])
  /// Nullable/source-owned until a canonical program hierarchy exists.
  programId                  String?
  /// Nullable/source-owned; the source may not provide a unit.
  unitId                     String?
  /// Timezone snapshot captured at admission, plus the lineage it came from.
  facilityTimezone           String
  timezoneSource             String
  timezoneSourceReferenceId  String
  timezoneConfigurationId    String?
  timezoneConfiguration      FacilityTimezoneConfiguration? @relation(fields: [timezoneConfigurationId], references: [id])
  admittedAt                 DateTime
  /// Facility-timezone-derived calendar date (YYYY-MM-DD), stored verbatim so
  /// it is never re-derived under a different zone.
  serviceDate                String
  status                     EpisodeStatus                  @default(ACTIVE)
  acceptedFacilityResponseId String
  sourcePacketVersionId      String?
  sourceCustodyEventId       String?
  /// Optimistic-concurrency token, same discipline as every other aggregate.
  version                    Int                            @default(1)
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  caseLinks                  CaseEpisodeLink[]
  authorizations             EpisodeAuthorization[]
  reviews                    AuthorizationReview[]
  dayDecisions               AuthorizationDayDecision[]
  documentationGaps          DocumentationGap[]

  @@index([organizationId, status])
  @@index([sourceCaseId])
  @@index([facilityId])
}

/// Case-to-episode relationship. The (organization, acceptance) uniqueness
/// makes admission recording idempotent and the additive active-episode index
/// on Episode enforces the one-active-admission-source invariant. One accepted
/// facility response yields exactly one link.
model CaseEpisodeLink {
  id                    String                  @id @default(cuid())
  organizationId        String
  caseId                String
  case                  BehavioralHealthCase    @relation(fields: [caseId], references: [id])
  episodeId             String
  episode               Episode                 @relation(fields: [episodeId], references: [id])
  relationship          CaseEpisodeRelationship
  linkedAt              DateTime
  linkedByActorId       String
  sourceAcceptanceId    String
  sourcePacketVersionId String?
  sourceCustodyEventId  String?
  createdAt             DateTime                @default(now())

  @@unique([organizationId, sourceAcceptanceId])
  @@unique([caseId, episodeId])
  @@index([organizationId, caseId])
  @@index([episodeId])
}

/// Episode-owned authorization requirement fact.
model EpisodeAuthorization {
  id                                String                          @id @default(cuid())
  organizationId                    String
  episodeId                         String
  episode                           Episode                         @relation(fields: [episodeId], references: [id])
  /// Source references remain nullable/source-owned; no duplicate coverage.
  sourceCoverageId                  String?
  sourcePreAdmissionAuthorizationId String?
  levelOfCare                       String
  requirement                       EpisodeAuthorizationRequirement
  effectiveStartDate                String
  status                            EpisodeAuthorizationStatus      @default(OPEN)
  version                           Int                             @default(0)
  createdAt                         DateTime                        @default(now())
  updatedAt                         DateTime                        @updatedAt
  reviews                           AuthorizationReview[]
  dayDecisions                      AuthorizationDayDecision[]

  @@index([organizationId, episodeId])
  @@index([episodeId, status])
}

/// A payer utilization review of an episode authorization. Corrections are
/// append-only: a correction inserts a NEW review row that supersedes the
/// original via `supersededByReviewId`; the original is frozen (decision 5).
model AuthorizationReview {
  id                     String                     @id @default(cuid())
  organizationId         String
  episodeAuthorizationId String
  episodeAuthorization   EpisodeAuthorization       @relation(fields: [episodeAuthorizationId], references: [id])
  episodeId              String
  episode                Episode                    @relation(fields: [episodeId], references: [id])
  reviewType             AuthorizationReviewType
  requestedStartDate     String
  requestedEndDate       String
  dueAt                  DateTime?
  decisionStatus         AuthorizationReviewStatus  @default(PENDING)
  payerReferenceToken    String?
  recordedByActorId      String
  recordedAt             DateTime
  /// Correction chain: set when a later review supersedes this one.
  supersededByReviewId   String?                    @unique
  supersededByReview     AuthorizationReview?       @relation("AuthorizationReviewSupersession", fields: [supersededByReviewId], references: [id])
  supersedes             AuthorizationReview?       @relation("AuthorizationReviewSupersession")
  correctionReasonCode   String?
  version                Int                        @default(1)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  dayDecisions           AuthorizationDayDecision[]

  @@index([organizationId, episodeId])
  @@index([episodeAuthorizationId])
}

/// Inclusive-range day decision derived from a review (decision 4). The
/// governed source event id and its supersession pointer are stored verbatim.
model AuthorizationDayDecision {
  id                     String                  @id @default(cuid())
  organizationId         String
  authorizationReviewId  String
  authorizationReview    AuthorizationReview     @relation(fields: [authorizationReviewId], references: [id])
  episodeAuthorizationId String
  episodeAuthorization   EpisodeAuthorization    @relation(fields: [episodeAuthorizationId], references: [id])
  episodeId              String
  episode                Episode                 @relation(fields: [episodeId], references: [id])
  startDate              String
  endDate                String
  outcome                AuthorizationDayOutcome
  denialReasonCode       DenialReasonCode?
  sourceEventId          String
  supersededByEventId    String?
  createdAt              DateTime                @default(now())

  @@index([organizationId, episodeId])
  @@index([authorizationReviewId])
  @@index([episodeAuthorizationId])
}

/// An episode-owned documentation gap with a controlled status and an
/// append-only status history (decision 5).
model DocumentationGap {
  id                          String                          @id @default(cuid())
  organizationId              String
  episodeId                   String
  episode                     Episode                         @relation(fields: [episodeId], references: [id])
  sourceAuthorizationReviewId String?
  categoryCode                DocumentationGapCategory
  operationalSummary          String?
  status                      DocumentationGapStatus          @default(OPEN)
  dueAt                       DateTime?
  assignedRole                String?
  assignedUserId              String?
  recordedByActorId           String
  resolvedByActorId           String?
  version                     Int                             @default(1)
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  statusHistory               DocumentationGapStatusHistory[]

  @@index([organizationId, episodeId])
  @@index([episodeId, status])
}

/// Append-only transition log for a documentation gap. One row per status
/// change; never updated or deleted.
model DocumentationGapStatusHistory {
  id                 String                  @id @default(cuid())
  organizationId     String
  documentationGapId String
  documentationGap   DocumentationGap        @relation(fields: [documentationGapId], references: [id])
  fromStatus         DocumentationGapStatus?
  toStatus           DocumentationGapStatus
  reasonCode         String?
  changedByActorId   String
  changedAt          DateTime
  createdAt          DateTime                @default(now())

  @@index([documentationGapId, changedAt])
}

/// Append-only governed event envelope (analytics.ts). Queryable columns are
/// projected out of the validated envelope, which is stored whole in `envelope`.
/// A correction supersedes at most one prior event (`supersedesEventId` unique)
/// — one active branch per correction family. No dispatcher reads this table
/// in S2; projection/marts are out of scope.
model GovernedEvent {
  id                String        @id
  organizationId    String
  eventTypeName     String
  eventTypeVersion  Int
  schemaName        String
  schemaVersion     String
  aggregateType     String
  aggregateId       String
  aggregateVersion  Int
  caseId            String?
  episodeId         String?
  correlationId     String
  causationId       String?
  correctionKind    String
  supersedesEventId String?       @unique
  reasonCode        String?
  classification    String
  metricEligibility String
  payloadHash       String
  envelope          Json
  effectiveAt       DateTime
  recordedAt        DateTime
  createdAt         DateTime      @default(now())
  outbox            OutboxRecord?

  @@index([organizationId, aggregateType, aggregateId])
  @@index([organizationId, episodeId])
  @@index([organizationId, eventTypeName])
}

/// Transactional outbox row written in the SAME transaction as its governed
/// event and source mutation (decision 7). Persistence only — no dispatcher,
/// worker, or delivery mechanism exists in S2. `status` stays PENDING.
model OutboxRecord {
  id              String        @id @default(cuid())
  organizationId  String
  governedEventId String        @unique
  governedEvent   GovernedEvent @relation(fields: [governedEventId], references: [id])
  eventTypeName   String
  aggregateType   String
  aggregateId     String
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())

  @@index([organizationId, status, createdAt])
}

// ---------------------------------------------------------------------------
// Prescreen Phase 3 persistence (local clarity_dev slice; ADR-0013/0014
// command semantics made durable). Enum values mirror the Phase 1 contract
// arrays in packages/domain-contracts/src/prescreen.ts — keep in sync.
// ---------------------------------------------------------------------------

enum PrescreenEncounterStatus {
  DRAFT
  ATTESTED
  SUBMITTED
  CENTRAL_INTAKE_REVIEW
  NEEDS_INFORMATION
  AUTHORIZED_REVIEW
  FACILITY_ROUTING
  TRANSPORT_PLANNING
  HANDED_OFF
  REDIRECTED
  DECLINED
  CANCELLED
}

enum PrescreenAssessmentStatus {
  DRAFT
  ATTESTED
  CORRECTED
  SUPERSEDED
}

enum PatientWillingness {
  WILLING
  NON_OPPOSED
  OPPOSED
  UNABLE_TO_EXPRESS
  FLUCTUATING
  UNKNOWN
  NOT_ASSESSED
}

enum PossiblePathway {
  POSSIBLE_FORMAL_VOLUNTARY_REVIEW
  POSSIBLE_NONCONTESTED_PATHWAY
  EMERGENCY_OR_LEGAL_REVIEW_REQUIRED
  MEDICAL_STABILIZATION_REQUIRED
  COMMUNITY_OR_OTHER_DISPOSITION
  UNDETERMINED
}

enum PrescreenReadinessTarget {
  CENTRAL_INTAKE_REVIEW
  AUTHORIZED_PRACTITIONER_REVIEW
  FACILITY_ROUTING
  TRANSPORT_PLANNING
  RECEIVING_HANDOFF
}

enum PacketRequirementState {
  NOT_STARTED
  REQUESTED
  RECEIVED
  UNDER_REVIEW
  ACCEPTED_FOR_PACKET
  MISSING
  UNAVAILABLE_WITH_REASON
  NOT_APPLICABLE_WITH_AUTHORITY
  NEEDS_CLARIFICATION
  STALE
  SUPERSEDED
}

model PrescreenEncounter {
  id                         String                       @id @default(cuid())
  organizationId             String
  /// Real tenant-checked linkage (Phase 3 ruling): starting an encounter
  /// requires an existing same-organization case; a miss is non-revealing.
  caseId                     String
  case                       BehavioralHealthCase         @relation(fields: [caseId], references: [id])
  status                     PrescreenEncounterStatus     @default(DRAFT)
  /// Optimistic-concurrency token, same discipline as every other aggregate.
  version                    Int                          @default(1)
  currentLocation            String
  presentingConcern          String
  currentAssessmentVersionId String?
  possiblePathway            PossiblePathway              @default(UNDETERMINED)
  createdBy                  String
  /// Command-supplied occurredAt times (server stamps them at the API
  /// boundary); NOT @updatedAt, so replays never rewrite recorded time.
  createdAt                  DateTime
  updatedAt                  DateTime
  insertedAt                 DateTime                     @default(now())
  assessmentVersions         PrescreenAssessmentVersion[]
  packetRequirements         PrescreenPacketRequirement[]
  submission                 PrescreenSubmission?

  @@index([organizationId, status])
  @@index([organizationId, caseId])
}

model PrescreenAssessmentVersion {
  id                                    String                    @id @default(cuid())
  organizationId                        String
  /// Caller-supplied domain id, unique per tenant only — another
  /// organization reusing the same id neither collides nor is disclosed.
  assessmentVersionId                   String
  encounterId                           String
  encounter                             PrescreenEncounter        @relation(fields: [encounterId], references: [id])
  versionNumber                         Int
  status                                PrescreenAssessmentStatus @default(DRAFT)
  createdAt                             DateTime
  createdBy                             String
  attestedAt                            DateTime?
  attestedBy                            String?
  parentVersionId                       String?
  changeReason                          String?
  willingness                           PatientWillingness
  /// Immutable value objects stored whole (hashed into contentHash), never
  /// queried relationally in this slice.
  orientation                           Json
  immediateMedicalStabilizationRequired Boolean                   @default(false)
  activeEmergencyOrLegalProcess         Boolean                   @default(false)
  possiblePathway                       PossiblePathway
  answers                               Json
  sources                               Json
  contentHash                           String?
  insertedAt                            DateTime                  @default(now())

  @@unique([organizationId, assessmentVersionId])
  @@index([organizationId, encounterId])
}

model PrescreenPacketRequirement {
  id                  String                     @id @default(cuid())
  organizationId      String
  encounterId         String
  encounter           PrescreenEncounter         @relation(fields: [encounterId], references: [id])
  requirementCode     String
  label               String
  state               PacketRequirementState
  blockingTargets     PrescreenReadinessTarget[]
  responsibleRoleCode String?
  resolutionWorkspace String
  sourceRuleId        String
  sourceRuleVersion   Int
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([organizationId, encounterId, requirementCode])
  @@index([organizationId, encounterId])
}

/// Recorded submission intent. Grants nothing; implies no acknowledgement,
/// review, or acceptance (ADR-0013 submission-as-intent).
model PrescreenSubmission {
  id                      String                   @id @default(cuid())
  organizationId          String
  encounterId             String                   @unique
  encounter               PrescreenEncounter       @relation(fields: [encounterId], references: [id])
  assessmentVersionId     String
  target                  PrescreenReadinessTarget
  receivingOrganizationId String
  submittedAt             DateTime
  submittedBy             String
  createdAt               DateTime                 @default(now())

  @@index([organizationId])
}
