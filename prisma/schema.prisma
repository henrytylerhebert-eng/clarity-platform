  ORGANIZATION_ADMIN
  INTAKE_COORDINATOR
  CLINICAL_REVIEWER
  PHYSICIAN_REVIEWER
  UTILIZATION_REVIEWER
  LEGAL_REVIEWER
  BENEFITS_VERIFICATION_SPECIALIST
  AUTHORIZATION_SPECIALIST
