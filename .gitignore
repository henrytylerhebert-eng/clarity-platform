node_modules/
dist/
build/
.next/
.turbo/
coverage/
*.tsbuildinfo

# Test artifacts
app/test-results/
playwright-report/

# OS metadata
.DS_Store

# Environment and secrets — never commit credentials
.env
.env.*
!.env.example

